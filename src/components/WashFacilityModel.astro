---
import { ROOM_LEGEND, ROOM_COLORS } from '../data/washFacilityModel';
---
<div class="facility-model" data-model="wash">
	<div class="facility-model-canvas-wrap">
		<canvas
			class="facility-model-canvas"
			role="img"
			aria-label="Interactive 3D model of a shared kitchen and bath facility. Four open, deep kitchens face the front of the building, each with room for a prep counter and a stove; five bathrooms directly behind them share the back wall, with doors facing the rear, opposite the kitchens. Drag to rotate."
		></canvas>
		<p class="facility-model-hint">Drag to rotate</p>
		<noscript><p class="facility-model-fallback">Interactive model requires JavaScript — see the room breakdown below.</p></noscript>
	</div>
	<ul class="facility-model-legend">
		{ROOM_LEGEND.map((item) => (
			<li><span class="swatch" style={`background:${ROOM_COLORS[item.type]}`}></span>{item.label}</li>
		))}
	</ul>
</div>

<script>
	import * as THREE from 'three';
	import { buildFloorsGroup, mountInteractiveModel, GRID_WIDTH } from '../lib/buildingModel';
	import { floors, ROOM_COLORS } from '../data/washFacilityModel';

	function showFallback(wrap: HTMLElement, message: string) {
		const fallback = document.createElement('p');
		fallback.className = 'facility-model-fallback';
		fallback.textContent = message;
		wrap.innerHTML = '';
		wrap.appendChild(fallback);
	}

	function initModel(root: Element) {
		const canvas = root.querySelector('canvas.facility-model-canvas') as HTMLCanvasElement | null;
		const wrap = root.querySelector('.facility-model-canvas-wrap') as HTMLElement | null;
		if (!canvas || !wrap) return;

		const group = buildFloorsGroup(floors, ROOM_COLORS);

		const ok = mountInteractiveModel({
			canvas,
			wrap,
			group,
			addExtras: (group, fit) => {
				// plain ground plane, generously sized around the building
				const groundGeo = new THREE.PlaneGeometry(GRID_WIDTH + 4, fit.size.z + 4);
				const ground = new THREE.Mesh(groundGeo, new THREE.MeshStandardMaterial({ color: 0xe7f1f1, roughness: 1 }));
				ground.rotation.x = -Math.PI / 2;
				ground.position.set(GRID_WIDTH / 2, -0.08, 0);
				group.add(ground);
			},
		});

		if (!ok) showFallback(wrap, "Your browser doesn't support the interactive 3D view — see the room breakdown below.");
	}

	document.querySelectorAll('[data-model="wash"]').forEach(initModel);
</script>
