---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-bg-image.jpg';
---
<Layout title="VisibleAid — watch your donation build a home" active="home">

<header class="hero">
	<div class="hero-photo">
		<Image
			src={heroImage}
			alt=""
			class="hero-img"
			widths={[640, 1280, 1920, 2560]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero-scrim"></div>
		<div class="hero-content">
			<div class="wrap">
				<div class="inner">
					<p class="eyebrow">Give, and watch it get built</p>
					<h1>A home for elders who have no one left.</h1>
					<p class="lede">We fund small, community-run facilities for elderly people living in poverty — and every facility reports its own numbers and photos back to you, in public, for as long as it stands.</p>
					<div class="hero-stat">
						<span class="n">58 people</span>
						<span class="l">currently have a home because of donors like you</span>
					</div>
					<div class="btnrow">
						<a class="btn btn-primary" href="#">Sponsor a facility</a>
						<a class="btn btn-ghost" href="/facilities">See where the money goes &#8599;</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>

<div class="ribbon">
	<div class="wrap">
		<div class="stat"><div class="n">5</div><div class="l">Facilities live</div></div>
		<div class="stat"><div class="n">340</div><div class="l">People served</div></div>
		<div class="stat"><div class="n">1,740</div><div class="l">Meals served, last 30 days</div></div>
		<div class="stat"><div class="n">3,610</div><div class="l">Facility uses, last 30 days</div></div>
	</div>
</div>

<section class="block">
	<div class="wrap">
		<div class="section-head center">
			<h2>Two ways we help</h2>
			<p>Different problems call for different structures. Both are run by the people who live and gather there, not by us.</p>
		</div>
		<div class="grid2">
			<a class="typecard a" href="/types#housing">
				<div class="icon">&#127968;</div>
				<span class="tag">Depth</span>
				<h3>Shared housing</h3>
				<p>Full homes for elderly people with no family able to support them. Residents share cooking, chores, and run a small food stall together.</p>
				<span class="go">See how it works &#8599;</span>
			</a>
			<a class="typecard b" href="/types#wash">
				<div class="icon">&#128686;</div>
				<span class="tag">Reach</span>
				<h3>Shared kitchen &amp; bath</h3>
				<p>Community-financed washing, bathing, and cooking facilities for people who already have shelter but lack basic sanitation.</p>
				<span class="go">See how it works &#8599;</span>
			</a>
		</div>
	</div>
</section>

<section class="block alt">
	<div class="wrap">
		<div class="section-head">
			<h2 style="font-size:26px;">Where we work</h2>
			<p>District-level locations only — exact addresses are withheld to protect residents.</p>
		</div>
		<div class="ph mapph"><span>world map — placeholder</span></div>
		<a class="btn btn-ghost on-cream" href="/facilities">Browse all locations &#8599;</a>
	</div>
</section>

<section class="block">
	<div class="wrap">
		<div class="donate-banner">
			<h3>You don't need to be a billionaire — a full facility costs under $50,000.</h3>
			<a class="btn btn-primary" href="#">Start a sponsorship</a>
		</div>
	</div>
</section>

</Layout>
