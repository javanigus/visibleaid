---
import Layout from '../../layouts/Layout.astro';
import facilities, { type Facility } from '../../data/facilities';

export function getStaticPaths() {
	return facilities.map((f) => ({
		params: { slug: f.slug },
		props: { facility: f },
	}));
}

interface Props {
	facility: Facility;
}

const { facility } = Astro.props;
---
<Layout title={`${facility.location} — VisibleAid`} active="facilities">

<header class="hero" style="padding-bottom:1px;">
	<div class="wrap" style="padding:44px 0 46px;">
		<p class="eyebrow"><a href="/facilities" style="color:inherit; text-decoration:none;">&larr; all facilities</a></p>
		<h1 style="font-size:34px;">{facility.location}</h1>
		<p class="lede" style="margin-top:10px;">{facility.typeLabel} &middot; {facility.residentsLabel}{facility.type === 'housing' ? ' residents' : ''} &middot; opened {facility.opened} &middot; partner: {facility.partner}</p>
	</div>
</header>

<section class="block">
	<div class="wrap">

		<div class="statgrid">
			{facility.stats.map((s) => (
				<div class="statcard"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>
			))}
		</div>

		<div class="section-head">
			<h2 style="font-size:21px;">Construction progress</h2>
			<p>Quarterly build photos, oldest to newest — see this facility go from bare land to opening.</p>
		</div>
		<div class="progress">
			{facility.progressSteps.map((step) => (
				<div class="step done"><div class="ph"><span>photo</span></div><div class="l">{step}</div></div>
			))}
		</div>

		<div class="section-head" style="margin-top:48px;">
			<h2 style="font-size:21px;">Latest quarterly photos</h2>
			<p>Faces shown only where a resident has opted in.</p>
		</div>
		<div class="photogrid">
			<div class="ph"><span>photo</span></div>
			<div class="ph"><span>photo</span></div>
			<div class="ph"><span>photo</span></div>
			<div class="ph"><span>photo</span></div>
		</div>

		<div class="section-head">
			<h2 style="font-size:21px;">Donor wall</h2>
			<p>Opt-in only.</p>
		</div>
		<div class="donorwall">
			{facility.donorWall.map((name) => (
				<span class="chip">{name}</span>
			))}
		</div>

	</div>
</section>

</Layout>
