---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import facilities, { type Facility } from '../../data/facilities';
import sharedHousingPhotos from '../../data/sharedHousingPhotos';
import sharedHousingConstructionPhotos from '../../data/sharedHousingConstructionPhotos';

export function getStaticPaths() {
	return facilities.map((f) => ({
		params: { slug: f.slug },
		props: { facility: f },
	}));
}

interface Props {
	facility: Facility;
}

const { facility } = Astro.props;
---
<Layout title={`${facility.location} — VisibleAid`} active="facilities">

<header class="hero" style="padding-bottom:1px;">
	<div class="wrap" style="padding:44px 0 46px;">
		<p class="eyebrow"><a href="/facilities" style="color:inherit; text-decoration:none;">&larr; all facilities</a></p>
		<h1 style="font-size:34px;">{facility.location}</h1>
		<p class="lede" style="margin-top:10px;">{facility.typeLabel} &middot; {facility.residentsLabel}{facility.type === 'housing' ? ' residents' : ''} &middot; opened {facility.opened} &middot; partner: {facility.partner}</p>
	</div>
</header>

<section class="block">
	<div class="wrap">

		<div class="statgrid">
			{facility.stats.map((s) => (
				<div class="statcard"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>
			))}
		</div>

		<div class="section-head">
			<h2 style="font-size:21px;">Construction progress</h2>
			<p>Quarterly build photos, oldest to newest — see this facility go from bare land to opening.</p>
		</div>
		<div class="progress">
			{facility.progressSteps.map((step, i) => (
				facility.type === 'housing' && sharedHousingConstructionPhotos[i] ? (
					<div class="step done">
						<a href={`#progress-${i}`} class="progress-thumb" aria-label={`View larger: ${sharedHousingConstructionPhotos[i].alt}`}>
							<Image src={sharedHousingConstructionPhotos[i].src} alt={sharedHousingConstructionPhotos[i].alt} widths={[260, 520]} sizes="(min-width: 760px) 230px, 45vw" />
						</a>
						<div class="l">{step}</div>
					</div>
				) : (
					<div class="step done"><div class="ph"><span>photo</span></div><div class="l">{step}</div></div>
				)
			))}
		</div>

		{facility.type === 'housing' && sharedHousingConstructionPhotos.map((photo, i) => (
			<div class="lightbox-overlay" id={`progress-${i}`} role="dialog" aria-modal="true" aria-label={photo.alt}>
				<a href="#_" class="lightbox-backdrop" aria-label="Close"></a>
				<figure class="lightbox-figure">
					<Image src={photo.src} alt={photo.alt} widths={[800, 1600]} sizes="90vw" />
					<a href="#_" class="lightbox-close" aria-label="Close">&times;</a>
				</figure>
			</div>
		))}

		<div class="section-head" style="margin-top:48px;">
			<h2 style="font-size:21px;">Latest quarterly photos</h2>
			<p>Faces shown only where a resident has opted in.</p>
		</div>
		<div class="photogrid">
			{facility.type === 'housing' ? (
				sharedHousingPhotos.map((photo, i) => (
					<a href={`#photo-${i}`} class="photogrid-thumb" aria-label={`View larger: ${photo.alt}`}>
						<Image src={photo.src} alt={photo.alt} widths={[300, 600]} sizes="(min-width: 760px) 230px, 45vw" />
					</a>
				))
			) : (
				<Fragment>
					<div class="ph"><span>photo</span></div>
					<div class="ph"><span>photo</span></div>
					<div class="ph"><span>photo</span></div>
					<div class="ph"><span>photo</span></div>
				</Fragment>
			)}
		</div>

		{facility.type === 'housing' && sharedHousingPhotos.map((photo, i) => (
			<div class="lightbox-overlay" id={`photo-${i}`} role="dialog" aria-modal="true" aria-label={photo.alt}>
				<a href="#_" class="lightbox-backdrop" aria-label="Close"></a>
				<figure class="lightbox-figure">
					<Image src={photo.src} alt={photo.alt} widths={[800, 1600]} sizes="90vw" />
					<a href="#_" class="lightbox-close" aria-label="Close">&times;</a>
				</figure>
			</div>
		))}

		<div class="section-head">
			<h2 style="font-size:21px;">Donor wall</h2>
			<p>Opt-in only.</p>
		</div>
		<div class="donorwall">
			{facility.donorWall.map((name) => (
				<span class="chip">{name}</span>
			))}
		</div>

	</div>
</section>

</Layout>
